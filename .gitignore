# Environment variables.
# Cualquier variante queda fuera (.env.test, .env.produccion, .env.vm...), salvo la
# plantilla. Los patrones anteriores solo cubrían .env, .env.local y .env.*.local:
# un .env.test con credenciales reales se podía commitear sin que git avisara.
.env
.env.*
!.env.example

# DB dumps
/scripts/*.sql
/scripts/*.json

# graphify output (should not be committed)
graphify-out/
dist2/*.exe
dist2/*.asar

# Database
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite-wal
*.sqlite-shm
datos_uphone.sql
db_prueba.sql
*_dump_*.sql
prima.sql

# Build output
out/
dist/
build/

# Dependencies
node_modules/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Logs
*.log
npm-debug.log*

# Agent communication (optional - keep estado_proyecto.md tracked)
.agentes/handoffs/
.agentes/validaciones/
.agentes/incidencias/
.agentes/archivo/

# AI tool directories (IDE/assistant configs - local only)
.adal/
.agents/
.antigravity/
.augment/
.bob/
.claude/
.codebuddy/
.commandcode/
.continue/
.cortex/
.crush/
.factory/
.goose/
.iflow/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.roo/
.trae/
.vibe/
.windsurf/
.zencoder/

# Windows reserved device name — no existe como archivo real, git no puede indexarlo
NUL.css

# Scripts temporales de desarrollo/parche en la raiz (no son parte del producto).
# Anclado a /scripts/: sin la barra inicial la regla ignoraba CUALQUIER carpeta
# scripts/ del repo en silencio, incluida backend/scripts/ (codigo de produccion).
/scripts/
patch.js
gen-hash.js
reset-admin.js
reset-uphone-users.js
update_users.py
AsesorPanel_reconstructed.jsx
old_AsesorPanel.jsx
best_match.txt
vite-proyect/
audio con requerimeintos/

# Prisma duplicado en raíz (el real está en backend/).
# Anclado con "/": sin la barra inicial el patrón coincide con CUALQUIER directorio
# llamado prisma, incluido backend/prisma/. Las migraciones entraron al repo solo
# porque se forzaron; cualquier archivo nuevo bajo backend/prisma/ quedaba fuera
# sin aviso.
/prisma/
/prisma.config.ts

# Temporary/scratch
scratch/
data/

# Skills config (local) — scaffolding de agentes IA, no es parte del producto
skills-lock.json
skills/

/src/generated/prisma
