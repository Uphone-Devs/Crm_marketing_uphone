# Scripts temporales de desarrollo/parche en la raíz (no son parte del producto).
# Anclado a la raíz (/scripts/) para no bloquear backend/scripts/, resources/scripts/,
# etc. — antes "scripts/" sin anclar ignoraba CUALQUIER carpeta scripts/ del repo en
# silencio (así se perdió backend/scripts/backfill-metricas-diarias.js, ver auditoría 2026-07-29).
/scripts/
patch.js
gen-hash.js
reset-admin.js
reset-uphone-users.js
update_users.py
AsesorPanel_reconstructed.jsx
old_AsesorPanel.jsx
best_match.txt
vite-proyect/
audio con requerimeintos/

# Prisma duplicado en raíz (el real está en backend/).
# Anclado con "/": sin la barra inicial el patrón coincide con CUALQUIER directorio
# llamado prisma, incluido backend/prisma/. Las migraciones entraron al repo solo
# porque se forzaron; cualquier archivo nuevo bajo backend/prisma/ quedaba fuera
# sin aviso.
/prisma/
/prisma.config.ts

