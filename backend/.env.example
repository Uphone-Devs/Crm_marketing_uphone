# ── Base de datos ─────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:password@localhost:5432/crm_marketing"

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET="cadena-aleatoria-minimo-32-caracteres"
JWT_EXPIRES_IN="8h"

# ── Servidor ──────────────────────────────────────────────────
# Puerto del backend en la VM. El codigo cae a 3001 si esta variable falta, asi que
# NO debe omitirse: el ingress de cloudflared apunta a 3002 y el servicio quedaria
# escuchando donde nadie lo busca.
PORT=3002
HOST=0.0.0.0

# ── CORS (opcional) ───────────────────────────────────────────
# Lista separada por comas. Sin definir: permite Electron + localhost + LAN 192.168.x.x
# CORS_ORIGIN=http://192.168.1.100:3000,http://192.168.1.101:3000

# ── Exclusión de usuarios backoff/apoyo ───────────────────────
# IDs separados por coma — esos usuarios no cuentan en reportes
# APOYO_USER_IDS=5,12

# ── Seed (solo para inicialización) ──────────────────────────
# SEED_PASSWORD=contraseña-temporal-cambiar-despues
