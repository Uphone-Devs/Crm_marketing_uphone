{
  "name": "crm-marketing-uphone",
  "version": "3.0.0",
  "description": "CRM Marketing Uphone — Plataforma de cobranza (Asesor / Supervisor / Admin)",
  "main": "out/main/index.js",
  "author": "Alexis Pillajo",
  "license": "ISC",
  "private": true,
  "scripts": {
    "copy-main": "node scripts/copy-main.js",
    "dev": "cmd /c \"set ELECTRON_RUN_AS_NODE=&& electron-vite dev\"",
    "build": "cmd /c \"set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-vite build && electron-builder\"",
    "build:app": "electron-vite build",
    "dist": "cmd /c \"set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder\"",
    "preview": "electron-vite preview",
    "check-ffmpeg": "node scripts/check-ffmpeg.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "rebuild:electron": "npx @electron/rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "doctor": "npx react-doctor@latest"
  },
  "reactDoctor": {
    "ignore": {
      "files": [".venv/**"],
      "overrides": [
        {
          "files": ["src/renderer/**"],
          "rules": ["deslop/unused-file"]
        }
      ]
    }
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "prisma": "^7.8.0",
    "recharts": "^3.8.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-oxc": "^0.4.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "supertest": "^7.2.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.6"
  },
  "build": {
    "extends": "./electron-builder.yml"
  }
}
